#!/usr/bin/env python3
"""Waybar status module for fprintd fingerprint readers."""

from __future__ import annotations

import getpass
import json
import os
import re
import shlex
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path
from typing import Any

ICON = "󰈷"
DEVICE_RE = re.compile(r'"(/net/reactivated/Fprint/Device/[^" ]+)"')
ERROR_PATTERNS = (
    ("already claimed", "reader is already claimed"),
    ("still busy with another operation", "reader is still busy"),
    ("device was disconnected", "reader disconnected during verification"),
    ("device has been removed", "reader was removed"),
    ("power down failed", "reader failed to power down"),
    ("unexpected result from device", "reader returned an unexpected result"),
)
FINGERS = (
    ("Left thumb", "left-thumb"),
    ("Left index finger", "left-index-finger"),
    ("Left middle finger", "left-middle-finger"),
    ("Left ring finger", "left-ring-finger"),
    ("Left little finger", "left-little-finger"),
    ("Right thumb", "right-thumb"),
    ("Right index finger", "right-index-finger"),
    ("Right middle finger", "right-middle-finger"),
    ("Right ring finger", "right-ring-finger"),
    ("Right little finger", "right-little-finger"),
)
FINGER_LABELS = {value: label for label, value in FINGERS}
ENROLLED_FINGER_RE = re.compile(r"^\s*-\s+#\d+:\s+([a-z-]+)\s*$")


def run(*args: str, timeout: float = 3.0) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            args,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(args, 127, "", str(exc))


def state_path() -> Path:
    root = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    return root / "omarchy-fingerprint-status" / "state.json"


def load_state(path: Path) -> dict[str, Any]:
    try:
        data = json.loads(path.read_text())
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_state(path: Path, state: dict[str, Any]) -> None:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        temporary = path.with_suffix(".tmp")
        temporary.write_text(json.dumps(state, separators=(",", ":")))
        temporary.replace(path)
    except OSError:
        pass


def get_devices() -> list[str]:
    result = run(
        "busctl", "call", "net.reactivated.Fprint",
        "/net/reactivated/Fprint/Manager",
        "net.reactivated.Fprint.Manager", "GetDevices",
    )
    if result.returncode != 0:
        return []
    return DEVICE_RE.findall(result.stdout)


def get_property(device: str, name: str) -> str | None:
    result = run(
        "busctl", "get-property", "net.reactivated.Fprint", device,
        "net.reactivated.Fprint.Device", name,
    )
    if result.returncode != 0:
        return None
    value = result.stdout.strip()
    if value.startswith("b "):
        return value[2:].strip()
    if value.startswith('s "') and value.endswith('"'):
        return value[3:-1]
    return value.split(" ", 1)[-1] if " " in value else value


def service_is_active() -> bool:
    return run("systemctl", "is-active", "fprintd.service").stdout.strip() == "active"


def service_condition() -> tuple[bool, str]:
    masked = run("systemctl", "is-enabled", "fprintd.service")
    if masked.stdout.strip() == "masked":
        return False, "fprintd is masked"
    failed = run("systemctl", "is-failed", "fprintd.service")
    if failed.stdout.strip() == "failed":
        return False, "fprintd service failed"
    return True, ""


def recent_error(since_epoch: float) -> tuple[float, str]:
    since = f"@{max(0, int(since_epoch) - 1)}"
    result = run(
        "journalctl", "-u", "fprintd.service", "--since", since,
        "--no-pager", "-o", "short-unix", "-n", "80",
    )
    newest_time = 0.0
    newest_message = ""
    if result.returncode != 0:
        return newest_time, newest_message
    for line in result.stdout.splitlines():
        lower = line.lower()
        for needle, description in ERROR_PATTERNS:
            if needle in lower:
                match = re.match(r"^(\d+(?:\.\d+)?)", line)
                event_time = float(match.group(1)) if match else time.time()
                if event_time >= newest_time:
                    newest_time = event_time
                    newest_message = description
                break
    return newest_time, newest_message


def human_age(epoch: float | int | None, now: float) -> str:
    if not epoch:
        return "never observed"
    seconds = max(0, int(now - float(epoch)))
    if seconds < 5:
        return "just now"
    if seconds < 60:
        return f"{seconds}s ago"
    minutes = seconds // 60
    if minutes < 60:
        return f"{minutes}m ago"
    hours = minutes // 60
    if hours < 48:
        return f"{hours}h ago"
    return datetime.fromtimestamp(float(epoch)).astimezone().strftime("%Y-%m-%d %H:%M")


def inspect(now: float | None = None) -> dict[str, Any]:
    now = time.time() if now is None else now
    path = state_path()
    state = load_state(path)
    active_timeout = max(5, int(os.environ.get("OMARCHY_FINGERPRINT_ACTIVE_TIMEOUT", "30")))
    error_ttl = max(10, int(os.environ.get("OMARCHY_FINGERPRINT_ERROR_TTL", "300")))

    service_ok, service_reason = service_condition()
    daemon_active = service_is_active() if service_ok else False
    discovered = bool(state.get("device_discovered"))
    should_query = service_ok and (daemon_active or not discovered)
    devices = get_devices() if should_query else []
    cached_names = state.get("devices", [])
    names = [name for name in cached_names if isinstance(name, str)] if isinstance(cached_names, list) else []
    active = False
    if should_query:
        names = []
        for device in devices:
            name = get_property(device, "name")
            if name and name not in names:
                names.append(name)
            needed = get_property(device, "finger-needed") == "true"
            present = get_property(device, "finger-present") == "true"
            active = active or needed or present
        state["device_discovered"] = True

    previous_active = bool(state.get("active"))
    if active:
        if not previous_active or not state.get("active_since"):
            state["active_since"] = now
        state["last_used"] = now
    elif previous_active:
        state["last_used"] = now
        state["active_since"] = None

    last_check = float(state.get("last_check", now - error_ttl))
    error_time, error_message = recent_error(last_check)
    ignore_errors_before = float(state.get("ignore_errors_before", 0))
    if (
        error_time
        and error_time > ignore_errors_before
        and error_time >= float(state.get("last_error", 0))
    ):
        state["last_error"] = error_time
        state["last_error_message"] = error_message

    state.update({"active": active, "last_check": now, "devices": names})
    save_state(path, state)

    active_for = now - float(state.get("active_since") or now)
    last_error = float(state.get("last_error", 0))
    error_is_recent = bool(last_error and now - last_error <= error_ttl)

    if not service_ok or not names:
        status = "disabled"
        reason = service_reason or "no fingerprint reader detected"
    elif active and active_for >= active_timeout:
        status = "stuck"
        reason = f"reader has remained active for {int(active_for)}s"
    elif error_is_recent and state.get("last_error_message") in {
        "reader is already claimed", "reader is still busy"
    }:
        status = "stuck"
        reason = str(state["last_error_message"])
    elif active:
        status = "active"
        reason = "reader is waiting for a fingerprint"
    else:
        status = "ready"
        reason = "reader is ready"

    tooltip = [
        f"Fingerprint reader: {status}",
        reason,
        "",
        f"Device: {', '.join(names) if names else 'none'}",
        f"Last used: {human_age(state.get('last_used'), now)}",
    ]
    if state.get("last_error"):
        tooltip.append(f"Last issue: {human_age(state['last_error'], now)} — {state.get('last_error_message', 'unknown')}")
    tooltip.extend((
        "",
        "Gray disabled · Green ready",
        "Blue active · Red stuck",
        "",
        "Left-click: test reader",
        "Middle-click: clear status history",
        "Right-click: actions menu",
    ))

    return {
        "text": ICON,
        "class": status,
        "tooltip": "\n".join(tooltip),
        "alt": status,
        "percentage": 100 if status == "ready" else 0,
    }


def diagnose() -> int:
    payload = inspect()
    print(payload["tooltip"])
    print()
    print("fprintd:", run("systemctl", "is-active", "fprintd.service").stdout.strip() or "unknown")
    print("devices:", len(get_devices()))
    return 0


def notify(title: str, message: str = "") -> None:
    if run("notify-send", "-u", "low", title, message).returncode != 0:
        print(f"{title}: {message}".rstrip())


def clear_history(*, notify_user: bool = True) -> int:
    now = time.time()
    path = state_path()
    try:
        save_state(path, {
            "active": False,
            "last_check": now,
            "ignore_errors_before": now,
        })
    except OSError as exc:
        if notify_user:
            notify("Fingerprint status", f"Could not clear history: {exc}")
        return 1
    if notify_user:
        notify("Fingerprint status", "Status history cleared")
    return 0


def current_user() -> str:
    return os.environ.get("USER") or os.environ.get("LOGNAME") or getpass.getuser()


def run_fprintd(*args: str) -> int:
    try:
        return subprocess.run(args, check=False).returncode
    except OSError as exc:
        print(f"Could not run {args[0]}: {exc}", file=sys.stderr)
        return 127


def test_reader() -> int:
    return run_fprintd("fprintd-verify", current_user())


def valid_finger(finger: str) -> bool:
    if finger in FINGER_LABELS:
        return True
    print(f"Unknown finger: {finger}", file=sys.stderr)
    return False


def confirm(prompt: str) -> bool:
    try:
        return input(f"{prompt} [y/N] ").strip().lower() in {"y", "yes"}
    except (EOFError, KeyboardInterrupt):
        print()
        return False


def enroll_fingerprint(finger: str) -> int:
    if not valid_finger(finger):
        return 2
    label = FINGER_LABELS[finger]
    print(f"Enrolling {label.lower()} for {current_user()}…")
    result = run_fprintd("fprintd-enroll", "-f", finger, current_user())
    if result == 0:
        clear_history(notify_user=False)
        print(f"{label} enrolled successfully.")
    else:
        print(f"Could not enroll {label.lower()}.", file=sys.stderr)
    return result


def replace_fingerprint(finger: str) -> int:
    if not valid_finger(finger):
        return 2
    label = FINGER_LABELS[finger]
    if not confirm(
        f"Replace {label.lower()} for {current_user()}? The saved print will be overwritten."
    ):
        print("Replacement cancelled.")
        return 0
    return enroll_fingerprint(finger)


def reset_fingerprints() -> int:
    user = current_user()
    if not confirm(f"Delete all saved fingerprints for {user}?"):
        print("Fingerprint reset cancelled.")
        return 0
    result = run_fprintd("fprintd-delete", user)
    if result == 0:
        clear_history(notify_user=False)
        print("All saved fingerprints were deleted. Use Add fingerprint to enroll again.")
    else:
        print("Could not delete saved fingerprints.", file=sys.stderr)
    return result


def reset_reader() -> int:
    print("Restarting fprintd…")
    result = subprocess.run(
        ("sudo", "systemctl", "restart", "fprintd.service"),
        check=False,
    )
    if result.returncode == 0:
        clear_history(notify_user=False)
        print("fprintd restarted and status history cleared.")
    else:
        print("Could not restart fprintd.", file=sys.stderr)
    return result.returncode


def launch_terminal(action: str, *args: str) -> int:
    launcher = "omarchy-launch-floating-terminal-with-presentation"
    command = " ".join(
        shlex.quote(part) for part in (str(Path(__file__).resolve()), action, *args)
    )
    try:
        subprocess.Popen(
            (launcher, command),
            start_new_session=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return 0
    except OSError as exc:
        notify("Fingerprint status", f"Could not open terminal: {exc}")
        return 1


def enrolled_fingers() -> list[str] | None:
    result = run("fprintd-list", current_user(), timeout=10.0)
    if result.returncode != 0:
        message = result.stderr.strip() or "Could not list registered fingerprints"
        notify("Fingerprint status", message)
        return None
    found = {
        match.group(1)
        for line in result.stdout.splitlines()
        if (match := ENROLLED_FINGER_RE.match(line))
        and match.group(1) in FINGER_LABELS
    }
    return [finger for _label, finger in FINGERS if finger in found]


def choose_finger(
    title: str,
    fingers: list[str] | None = None,
    annotation: str = "",
) -> str | None:
    available = set(fingers) if fingers is not None else None
    entries = [
        (f"{label}{annotation}", finger)
        for label, finger in FINGERS
        if available is None or finger in available
    ]
    labels = tuple(label for label, _finger in entries)
    result = run("omarchy-menu-select", title, *labels, "--", "--width", "720", "--maxheight", "600", timeout=120.0)
    choice = result.stdout.strip()
    return next((finger for label, finger in entries if choice == label), None)


def choose_registered_finger() -> str | None:
    fingers = enrolled_fingers()
    if fingers is None:
        return None
    if not fingers:
        notify(
            "Fingerprint status",
            f"No fingerprints are registered for {current_user()}",
        )
        return None
    return choose_finger(
        "Replace registered fingerprint",
        fingers,
        " (registered)",
    )


def actions_menu() -> int:
    options = (
        "Test fingerprint reader",
        "Add fingerprint",
        "Replace fingerprint",
        "Reset all fingerprints",
        "Diagnose fingerprint reader",
        "Clear status history",
        "Restart fprintd service",
    )
    result = run("omarchy-menu-select", "Fingerprint", *options, "--", "--width", "720", "--maxheight", "600", timeout=120.0)
    choice = result.stdout.strip()
    if choice == options[0]:
        return launch_terminal("test")
    if choice == options[1]:
        finger = choose_finger("Add fingerprint")
        return launch_terminal("enroll", finger) if finger else 0
    if choice == options[2]:
        finger = choose_registered_finger()
        return launch_terminal("replace", finger) if finger else 0
    if choice == options[3]:
        return launch_terminal("reset-fingerprints")
    if choice == options[4]:
        return launch_terminal("diagnose")
    if choice == options[5]:
        return clear_history()
    if choice == options[6]:
        return launch_terminal("reset")
    return 0


def main() -> int:
    command = sys.argv[1] if len(sys.argv) > 1 else "status"
    if command in {"status", "--status"}:
        print(json.dumps(inspect(), ensure_ascii=False))
        return 0
    if command in {"diagnose", "--diagnose"}:
        return diagnose()
    if command == "test":
        return test_reader()
    if command == "open-test":
        return launch_terminal("test")
    if command == "clear":
        return clear_history()
    if command in {"enroll", "replace"}:
        if len(sys.argv) != 3:
            print(f"Usage: omarchy-fingerprint-status {command} <finger>", file=sys.stderr)
            return 2
        if command == "enroll":
            return enroll_fingerprint(sys.argv[2])
        return replace_fingerprint(sys.argv[2])
    if command == "reset-fingerprints":
        return reset_fingerprints()
    if command == "reset":
        return reset_reader()
    if command == "open-reset":
        return launch_terminal("reset")
    if command == "menu":
        return actions_menu()
    print(
        "Usage: omarchy-fingerprint-status "
        "[status|diagnose|test|open-test|clear|enroll <finger>|replace <finger>|"
        "reset-fingerprints|reset|open-reset|menu]",
        file=sys.stderr,
    )
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
